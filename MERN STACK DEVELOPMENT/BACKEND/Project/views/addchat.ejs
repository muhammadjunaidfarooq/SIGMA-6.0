<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add New Chats</title>
</head>
<body>
    <h2>Here you add a new chat</h2>
    <form action="/chats" method="POST"> 
        <input type="text" name="from" id="sender" placeholder="Who are you?"> <br><br>
        <textarea name="msg" id="message" placeholder="Write your message here..." cols="35" rows="5"></textarea><br><br>
        <input type="text" name="to" id="sender" placeholder="add receiver"> &nbsp;
        <button>Send</button>
    </form>
</body>
</html> 